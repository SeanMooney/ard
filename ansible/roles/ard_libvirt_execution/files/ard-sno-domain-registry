#!/usr/bin/env python3
"""Atomically claim or release execution-host SNO cluster domains."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import tempfile

DOMAIN = re.compile(r"^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$")
DEPLOYMENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def owner(args: argparse.Namespace) -> dict[str, str]:
    return {
        "deployment": args.deployment,
        "remote_state_dir": args.remote_state_dir,
        "cluster_domain": args.domain,
    }


def read(path: Path) -> dict[str, str]:
    with path.open(encoding="utf-8") as stream:
        value = json.load(stream)
    if not isinstance(value, dict):
        raise ValueError(f"{path} owner is not an object")
    return value


def publish(path: Path, value: dict[str, str]) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("claim", "release"))
    parser.add_argument("--root", required=True)
    parser.add_argument("--domain", required=True)
    parser.add_argument("--deployment", required=True)
    parser.add_argument("--remote-state-dir", required=True)
    args = parser.parse_args()

    if not DOMAIN.fullmatch(args.domain) or not DEPLOYMENT.fullmatch(args.deployment):
        print("invalid cluster domain or deployment name", file=sys.stderr)
        return 2
    root = Path(args.root).resolve()
    deployment_dir = root / args.deployment
    path = deployment_dir / "domain-ownership.json"
    expected = owner(args)

    try:
        root.mkdir(mode=0o750, parents=True, exist_ok=True)
        deployment_dir.mkdir(mode=0o750, exist_ok=True)
        lock = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if args.action == "claim":
                for candidate in root.glob("*/domain-ownership.json"):
                    existing = read(candidate)
                    if existing.get("cluster_domain") == args.domain and existing != expected:
                        print(json.dumps(existing, sort_keys=True), file=sys.stderr)
                        return 3
                existing = read(path) if path.exists() else None
                if existing is not None and existing != expected:
                    print(json.dumps(existing, sort_keys=True), file=sys.stderr)
                    return 3
                if existing is None:
                    publish(path, expected)
                print(json.dumps(expected, sort_keys=True))
            else:
                existing = read(path) if path.exists() else None
                if existing == expected:
                    path.unlink()
                    print("released")
                else:
                    print("retained")
        finally:
            os.close(lock)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
